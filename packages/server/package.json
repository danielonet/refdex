{
  "name": "@refdex/server",
  "version": "0.1.0",
  "private": true,
  "description": "RefDex daemon: file watching, indexing, SQLite and the MCP server",
  "type": "module",
  "bin": {
    "refdex": "dist/refdex.cjs"
  },
  "scripts": {
    "check-types": "tsc -p .",
    "dev": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build": "node scripts/build.mjs",
    "build:sea": "node scripts/build.mjs && node scripts/build-sea.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@refdex/core": "*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^6.0.3"
  }
}
